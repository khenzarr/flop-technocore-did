# Dashboard: set this only when the optional read-only indexer is deployed.
# It must be an origin/root URL with no credentials, query, fragment, or path.
# Use HTTPS except for explicit loopback/local development.
TECHNOCORE_INDEXER_URL=https://indexer.example.com
# Optional indexer defaults (never put secrets in this file):
TECHNOCORE_BASE_URL=https://technocore.chat
TECHNOCORE_INDEX_DB=./data/technocore-index.sqlite3
TECHNOCORE_INDEX_INTERVAL_SECONDS=15
TECHNOCORE_INDEX_MAX_ROOMS=50
TECHNOCORE_INDEX_BIND=127.0.0.1
TECHNOCORE_INDEX_PORT=8788
